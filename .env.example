# Database mode: "sqlite" (default, no setup) or "mysql".
#   Local dev:          sqlite (nothing to configure) OR mysql on XAMPP/phpMyAdmin
#   Production (Render): mysql — point at the free InfinityFree MySQL database.
#   On Render these DB_* values are set in the Render dashboard/env, see render.yaml.
DB_MODE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ojtconnect

# Social sign-in (leave blank to disable). Callback URLs:
#   {SERVER_URL}/api/auth/google/callback
#   {SERVER_URL}/api/auth/facebook/callback
#   {SERVER_URL}/api/auth/yahoo/callback
# To get keys:
#   Google:  https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID)
#   Facebook:https://developers.facebook.com/apps               (App ID + Secret)
#   Yahoo:   https://developer.yahoo.com/apps                    (OAuth App Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# On Render these auto-fall back to RENDER_EXTERNAL_URL, so you only need to set
# them here for local development.
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# JWT signing secret. Render auto-generates this (render.yaml: JWT_SECRET).
# Keep it secret — anyone with it can forge login sessions.
JWT_SECRET=

# Administrator account auto-created at startup (role: admin). Change the password after first login.
ADMIN_EMAIL=admin@ojtconnect.com
ADMIN_PASSWORD=admin123

# Email notifications (account request approved/declined). Leave SMTP_HOST blank to
# log emails to the console instead of sending (development mode).
# NOTE: Render's free instances block outbound SMTP on ports 25/465/587 — use a
# relay on port 2525/8025 instead, or leave blank to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ojtconnect.com
MAIL_FROM_NAME=OJT Connect