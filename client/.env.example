# Build-time env vars for the Vite frontend (client/.env file).
# Copy this file to client/.env and fill in the real URLs when building
# the version that will be uploaded to InfinityFree.

# Public URL of the deployed backend (Render), e.g. https://ojt-connect.onrender.com
# The app prefixes every API call (/api/auth, /api/postings, ...) with this.
# Leave empty to call the same origin the page was served from.
VITE_API_URL=

# Backend URL used for Socket.IO realtime chat/notifications. Use the same
# Render URL as above. Leave empty for same-origin.
VITE_SOCKET_URL=