# InfinityFree / Apache single-page-app routing.
# Serve index.html for every path that isn't a real file or directory
# so React Router works on refresh and deep links (e.g. /login, /postings).
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]